do -- player func
    function frag:sleepcheck(Player)
        local Animations = Player:FindFirstChild("AnimationController") and Player.AnimationController:GetPlayingAnimationTracks();
        for _,v in pairs(Animations) do
            if (v.IsPlaying and v.Animation.AnimationId == "rbxassetid://13280887764") then
                return true;
            end;
        end;
        return false;
    end;
    --
    function frag:AICheck(Player, type)
        if (frag.aim.aicheck and type == "aim" and Player:FindFirstChild("Head") and Player.Head.CollisionGroup == "NPC") then
            return true;
        elseif (frag.hitbox.aicheck and type == "hitbox" and Player:FindFirstChild("Head") and Player.Head.CollisionGroup == "NPC") then
            return true;
        end;
        return false;
    end;
    --
    function frag:TeamCheck(Player, type)
        if (frag.aim.teamcheck and type == "aim" and Player:FindFirstChild("Head") and Player.Head.Dot.Enabled) then
            return true;
        elseif (frag.hitbox.teamcheck and type == "hitbox" and Player:FindFirstChild("Head") and Player.Head.Dot.Enabled) then
            return true
        end
        return false;
    end;
    --
    function frag:getplayer()
        local closest = nil;
        local closestMagnitude = math.huge;
        local middle = frag.varis.camera.ViewportSize / 2;
        for _,v in pairs(workspace:GetChildren()) do
            if (v:FindFirstChild("HumanoidRootPart") and not frag:sleepcheck(v) and not frag:AICheck(v, "aim") and not frag:TeamCheck(v, "aim")) then
                local PartPos, OnScreen = frag.varis.camera.WorldToViewportPoint(frag.varis.camera, v:GetPivot().Position);
                local Magnitude = (Vector2.new(PartPos.X, PartPos.Y) - middle).magnitude;
                if (Magnitude < fovcircle.Radius and Magnitude < closestMagnitude and OnScreen) then
                    closestMagnitude = Magnitude;
                    closest = v;
                end;
            end;
        end;
        return closest;
    end;
end;
