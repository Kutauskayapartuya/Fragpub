                box.FillColor = Color3.new(1, 1, 1)
                box.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                box.Adornee = descendant
                box.Parent = descendant.HumanoidRootPart

                spawn(function()
                    while box and box.Parent do
                        box.OutlineColor = updateColor()
                        wait(0.1)
                    end
                end)
            end
        end)
    else
        for _, model in pairs(game:GetService("Workspace"):GetDescendants()) do
            if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
                local box = model.HumanoidRootPart:FindFirstChild("BoxESP")
                if box then
                    box:Destroy()
                end
            end
        end
    end
end)

local camera = game:GetService("Workspace").CurrentCamera
local RunService = game:GetService("RunService")
local line = Drawing.new("Line")
line.Visible = false
line.Thickness = 1
line.Transparency = 1
local connection

esp:Toggle("Line ESP", function(state)
    if state then
        line.Visible = true
        local hue = 0
        connection = RunService.RenderStepped:Connect(function()
            hue = (hue + 1) % 360
            line.Color = Color3.fromHSV(hue/360, 1, 1)
            
            local closestDistance = math.huge
            local closestHead = nil
            
            for _, model in pairs(game:GetService("Workspace"):GetDescendants()) do
                if model:IsA("Model") and model:FindFirstChild("Head") then
                    local vector, onScreen = camera:WorldToScreenPoint(model.Head.Position)
                    if onScreen then
                        local distance = (model.Head.Position - camera.CFrame.Position).Magnitude
                        if distance < closestDistance then
                            closestDistance = distance
                            closestHead = model.Head
                        end
                    end
                end
            end
            
            if closestHead then
                local vector, onScreen = camera:WorldToScreenPoint(closestHead.Position)
                if onScreen then
                    line.Visible = true
                    line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                    line.To = Vector2.new(vector.X, vector.Y)
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end)
    else
        if connection then
            connection:Disconnect()
        end
        line.Visible = false
    end
end)

