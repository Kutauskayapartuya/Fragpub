do -- 
    frag.varis.userinput.InputBegan:Connect(function(_, gme)
        if gme then return end
        --
        if (frag.holding and not frag.target and not frag.aiming) then
            frag.aiming = true
            repeat task.wait() until frag:getplayer() ~= nil and frag.aiming
            if frag.aiming and frag:getplayer() ~= nil then
                frag.target = frag:getplayer()
            end
        end
    end)
    
    frag.varis.userinput.InputEnded:Connect(function(_, gme)
        if gme then return end
        --
        if (not frag.holding and frag.aiming) then
            frag.target = nil
            frag.aiming = false
        end
    end)
end
