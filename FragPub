                frag:UpdateHitbox()
            end})

            hitbox:Toggle({ title = "team check", default = false, callback = function(bool)
                frag.hitbox.teamcheck = bool
                frag:UpdateHitbox()
            end})
            --
            local exploit = Tabs.Combat:Section("exploits", "left");
            do
                exploit:Toggle({ title = "enabled", default = false, callback = function(bool)
                    frag.exploits.enabled = bool
                end})

                exploit:Toggle({ title = "jump-shoot", default = false, callback = function(bool)
                    frag.exploits.jumpshoot = bool
                end})

                exploit:Toggle({ title = "omni-sprint", default = false, callback = function(bool)
                    frag.exploits.omnisprint = bool
                end})

                exploit:Toggle({ title = "long-neck", default = false, callback = function(bool)
                    frag.exploits.longneck = bool
                end}):Keybind({ title = "long neck", keybindlist = true, mode = "Toggle", keybindname = "long neck", callback = function(key)
                    if frag.exploits.longneck and key then
                        frag.varis.localchar.Bottom.PrismaticConstraint.UpperLimit = 6
                        frag.varis.localchar.Bottom.PrismaticConstraint.LowerLimit = 6
                    else
                        frag.varis.localchar.Bottom.PrismaticConstraint.UpperLimit = 3
                        frag.varis.localchar.Bottom.PrismaticConstraint.LowerLimit = 1.65
                    end
                end})
            end
        end
    end
    --
    do -- visuals
        local players = Tabs.Visuals:Section("player", "left");
        do
            players:Toggle({ title = "enabled", default = false, callback = function(bool)
                frag.esp.enabled = bool
            end})

            players:Toggle({ title = "boxes", default = false, callback = function(bool)
                frag.esp.box = bool
            end})

            players:Toggle({ title = "name", default = false, callback = function(bool)
                frag.esp.name = bool
            end})

            players:Toggle({ title = "weapon", default = false, callback = function(bool)
                frag.esp.weapon = bool
            end})

            players:Toggle({ title = "healthbar", default = false, callback = function(bool)
                frag.esp.healthbar = bool
            end})
        end
    end
end

game:GetService("RunService").Heartbeat:Connect(function(Delta)
    if frag.aim.enabled and frag.target ~= nil and frag.target:FindFirstChild("Head") then
        LastVelocity, CurrentPos = frag:CalculateVelocity(frag.target["Head"], CurrentPos, LastVelocity, Delta)
        local Position, OnScreen = frag.varis.camera:WorldToViewportPoint(frag:GetPrediction(LastVelocity))
        if OnScreen then
            local MouseLocation = frag.varis.userinput:GetMouseLocation()
            local XOffset, YOffset = frag.aim.smooth, frag.aim.smooth
            local MouseSens = UserSettings().GameSettings.MouseSensitivity
            local Scale = 1.5 / MouseSens
            if frag.aim.autocalc then
                XOffset, YOffset = 0.1 * Scale, 0.1 * Scale
            end
            mousemoverel((Position.X - MouseLocation.X) * XOffset, (Position.Y - MouseLocation.Y) * YOffset)
        end
    else
        LastVelocity = Vector3.new(0, 0, 0)
    end
    --
    local size = frag.aim.realfov / math.tan(math.rad(frag.varis.camera.FieldOfView / 2))
    frag.aim.fov = size
    fovcircle.Radius = frag.aim.dynamic and frag.aim.fov or frag.aim.realfov
end)
